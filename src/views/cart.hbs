<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <title>Carrito {{cartId}}</title>
</head>

<body>

  {{#if error}}
    <p>{{error}}</p>

  {{else}}
    <h1>Carrito {{cartId}}</h1>

    {{#if items.length}}
      <table border="1" cellpadding="6" cellspacing="0">
        <thead>
          <tr>
            <th>producto</th>
            <th>categoria</th>
            <th>precio</th>
            <th>cantidad</th>
            <th>subtotal</th>
          </tr>
        </thead>
        <tbody>

          {{#each items}}
            <tr>
              <td><a href="/products/{{this.id}}">{{this.title}}</a></td>
              <td>{{this.category}}</td>
              <td>${{this.price}}</td>
              <td>{{this.quantity}}</td>
              <td>${{this.subtotal}}</td>
            </tr>
          {{/each}}

        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" align="right"><strong>total</strong></td>
            <td><strong>${{total}}</strong></td>
          </tr>
        </tfoot>
      </table>

    {{else}}
      <p>carrito vacio</p>
    {{/if}}
    
  {{/if}}

  <p><a href="/products">volver a productos</a></p>
</body>
</html>
